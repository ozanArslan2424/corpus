{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@ozanarslan/corpus",
	"version": "0.6.3",
	"description": "Small Typescript backend framework with only core utilities",
	"keywords": [
		"backend framework",
		"bun serve",
		"simple"
	],
	"homepage": "https://corpus-docs.fly.dev/",
	"bugs": {
		"url": "https://github.com/ozanArslan2424/corpus.git/issues"
	},
	"license": "MIT",
	"author": "Ozan Arslan <ozanarslanwork@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ozanArslan2424/corpus.git"
	},
	"files": [
		"dist",
		"LICENSE.txt",
		"THIRD_PARTY_LICENSES.txt"
	],
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"imports": {
		"#corpus-entry": {
			"corpus-src": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run build.ts",
		"test:serve": "bun run test/other/test-server.ts",
		"test:serve:src": "bun --conditions=corpus-src run test/other/test-server.ts",
		"test:http": "bun run test/other/http-simulation.ts",
		"test:http:src": "bun --conditions=corpus-src run test/other/http-simulation.ts",
		"test:ws": "bun run test/other/ws-simulation.ts",
		"test:ws:src": "bun --conditions=corpus-src run test/other/ws-simulation.ts",
		"test:benchmark": "bun run test/other/adapter-benchmark.ts",
		"test:benchmark:src": "bun --conditions=corpus-src run test/other/adapter-benchmark.ts",
		"test:all": "bun test --only-failures && bun run test:http -s && bun run test:ws -s && bun run test:benchmark",
		"test:all:src": "bun --conditions=corpus-src test --only-failures && bun run test:http:src -s && bun run test:ws:src -s && bun run test:benchmark:src"
	},
	"devDependencies": {
		"@standard-schema/spec": "^1.1.0",
		"@types/bun": "^1.3.14",
		"@types/express": "^5.0.6",
		"arktype": "^2.2.3",
		"bun-plugin-dts": "^0.4.0",
		"elysia": "^1.4.29",
		"express": "^5.2.1",
		"memoirist": "^1.2.1",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"typescript": "^6.0.2"
	}
}
