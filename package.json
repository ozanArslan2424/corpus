{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "corpus-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "pnpm -r run build",
		"test": "pnpm -r run test:all",
		"fm": "oxfmt --write",
		"lint": "oxlint --fix",
		"knip": "knip",
		"test:all": "pnpm -r --reporter=append-only test:all",
		"test:silent": "pnpm -r --reporter=append-only test:all 2>&1 | grep -E '\\((pass|fail)\\)|[0-9]+ (pass|fail)$'",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.14",
		"knip": "^6.14.2",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0"
	}
}
