{
	"$schema": "https://www.schemastore.org/package.json",
	"name": "@ozanarslan/corpus",
	"version": "0.6.3",
	"description": "Small Typescript backend framework with only core utilities",
	"keywords": [
		"backend framework",
		"bun serve",
		"simple"
	],
	"homepage": "https://corpus-docs.fly.dev/",
	"bugs": {
		"url": "https://github.com/ozanArslan2424/corpus.git/issues"
	},
	"license": "MIT",
	"author": "Ozan Arslan <ozanarslanwork@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ozanArslan2424/corpus.git"
	},
	"files": [
		"dist",
		"LICENSE.txt"
	],
	"type": "module",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"imports": {
		"#corpus": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ./build.ts",
		"test:serve": "bun run test/test-server.ts",
		"test:http": "bun run test/http-simulation.ts",
		"test:ws": "bun run test/ws-simulation.ts",
		"test:benchmark": "bun run test/RouterBenchmark.ts",
		"test:all": "bun test --only-failures && bun run test:http -s && bun run test:ws -s && bun run test:benchmark"
	},
	"devDependencies": {
		"@ozanarslan/utils": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"@types/bun": "^1.4.0",
		"arktype": "^2.2.3",
		"bun-plugin-dts": "^0.4.0",
		"memoirist": "^1.2.2",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"typescript": "6.0.2"
	}
}
