{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"workspaces": {
		".": {
			"ignoreBinaries": ["release.zsh"]
		},
		"packages/cli": {
			"entry": [
				"src/index.ts",
				"tsdown.config.ts",
				"corpus.config.ts",
				"test/**/*.test.ts",
				"test/other/**/*.ts"
			],
			"project": ["src/**/*.ts", "test/**/*.ts", "corpus.config.ts", "tsdown.config.ts"],
			"ignore": ["test/app/**", "test/other/apigen/generated.ts"]
		},
		"packages/corpus": {
			"entry": ["src/index.ts", "scripts/*.ts", "src/**/*.test.ts", "test/*.test.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/docs": {
			"entry": [
				"build.ts",
				"src/index.ts",
				"src/serve.ts",
				"src/check-hrefs.ts",
				"src/check-llms.ts",
				"src/files/scripts/*.ts"
			],
			"project": ["build.ts", "src/**/*.ts"]
		}
	}
}
